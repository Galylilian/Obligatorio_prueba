{
  "title": "Fall Detector - Dashboard",
  "uid": "fall-detector",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Total de Predicciones",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) as value FROM predictions",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Caídas Detectadas Hoy",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) as value FROM predictions WHERE label = 'fall' AND created_at >= CURRENT_DATE",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 10 }
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Clasificadas Esta Semana",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) as value FROM predictions WHERE created_at >= NOW() - INTERVAL '7 days'",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Confianza Promedio",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG(confidence)::numeric, 3) as value FROM predictions",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "unit": "percentunit"
      }
    },
    {
      "id": 5,
      "title": "Predicciones por Hora (últimas 24h)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, COUNT(*) AS value FROM predictions WHERE created_at >= NOW() - INTERVAL '24 hours' GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Distribución de Labels",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawQuery": true,
          "rawSql": "SELECT label, COUNT(*) as value FROM predictions GROUP BY label",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "pie",
        "displayLabels": ["name", "percent"]
      }
    },
    {
      "id": 7,
      "title": "Uso por Modelo",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawQuery": true,
          "rawSql": "SELECT model_type, COUNT(*) as value FROM predictions GROUP BY model_type",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "pie",
        "displayLabels": ["name", "percent"]
      }
    }
  ]
}