# Entorno: development | production
APP_ENV=development

# Modelo y datos
MODEL_PATH=models/resnet18_best.pth
LABEL_ENCODER_PATH=models/label_encoder.pkl
DATA_DIR=data/fused
RAW_DATA_DIR=data/raw
METADATA_PATH=data/metadata/fall_dataset_fused_metadata.csv
MLRUNS_DIR=mlruns

# API
API_HOST=0.0.0.0
API_PORT=8080
API_URL=http://localhost:8080

# Roboflow (scripts/download_dataset.py)
ROBOFLOW_API_KEY=tu_api_key_aqui

# Analytics (SQLite local por defecto en development; PostgreSQL + Grafana con Docker)
# DATABASE_URL=sqlite:///./data/analytics/fall_analytics.db
DATABASE_URL=postgresql+psycopg2://fallapp:fallapp@localhost:5432/fall_analytics
POSTGRES_USER=fallapp
POSTGRES_PASSWORD=fallapp
POSTGRES_DB=fall_analytics
HIGH_RISK_MIN_FALLS_WEEK=2
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
