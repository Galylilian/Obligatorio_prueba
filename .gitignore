# =============================
# DATA — se ignora el contenido pero se mantienen las carpetas
# Los .gitkeep permiten que las carpetas aparezcan en GitHub
# =============================

# raw — ignorar todo el contenido
data/raw/**
!data/raw/
!data/raw/**/.gitkeep

# scraped — ignorar imágenes y CSVs pero mantener carpetas
data/raw/scraped/**
!data/raw/scraped/
!data/raw/scraped/**/.gitkeep

# processed — ignorar imágenes pero mantener carpetas y el CSV de trazabilidad
data/processed/**
!data/processed/
!data/processed/**/.gitkeep
!data/processed/dataset_labels.csv

# video — ignorar uploads y frames
data/video/**
!data/video/
!data/video/**/.gitkeep